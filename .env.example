# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hermes_observability
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration (packages/backend, cmd/api)
API_PORT=3000
# Comma-separated allowed origins (required in production; e.g. https://app.example.com)
CORS_ORIGIN=*
# Signs session cookies (required in production; any long random string)
JWT_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Extra per-IP limit on signup/login
AUTH_RATE_LIMIT_MAX=60
# Reverse proxies in front of a service whose X-Forwarded-For is trusted (0 = none)
TRUSTED_PROXY_HOPS=1

# Collector Configuration (packages/backend, cmd/collector)
# Agents authenticate with an x-api-key created in the UI's Admin page
# (required in production; in development requests without a key go to tenant 1)
COLLECTOR_PORT=4318
MAX_BATCH_SIZE=1000

# Email Alert Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@hermes-observability.com
# How often the processor evaluates alert rules (Go duration: 30s, 1m, ...)
ALERT_CHECK_INTERVAL=30s

# UI Configuration
UI_PORT=3001

# Environment: "production" enables required secrets, mandatory API keys and Secure cookies
HERMES_ENV=development
LOG_LEVEL=debug
