# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hermes_observability
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated allowed origins (required in production; e.g. https://app.example.com)
CORS_ORIGIN=*
# Bearer token required on POST/PUT/DELETE /api/v1/alerts (required in production)
API_ADMIN_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Collector Configuration
COLLECTOR_PORT=4317
COLLECTOR_GRPC_PORT=4317
COLLECTOR_HTTP_PORT=4318
# Comma-separated API keys instrumented apps send as x-api-key (required in production)
COLLECTOR_API_KEYS=

# Email Alert Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=alerts@hermes-observability.com

# UI Configuration
UI_PORT=3001

# Environment
NODE_ENV=development
LOG_LEVEL=debug
