{
  "name": "hermes-observability",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "build:clean": "tsc --build --clean",
    "start": "concurrently \"npm run start:collector\" \"npm run start:processor\" \"npm run start:api\" \"npm run start:ui\"",
    "start:api": "go -C packages/backend run ./cmd/api",
    "start:collector": "go -C packages/backend run ./cmd/collector",
    "start:processor": "go -C packages/backend run ./cmd/processor",
    "start:ui": "npm run dev --workspace=packages/ui",
    "test": "go -C packages/backend test ./...",
    "test:coverage": "go -C packages/backend test -cover ./...",
    "test:system": "node scripts/test-system.js",
    "load-test:redis": "node scripts/load-test-redis-ingest.js",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint packages/*/src/**/*.ts",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json}\"",
    "docker": "node scripts/docker.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:rebuild": "docker-compose up -d --build",
    "docker:status": "docker-compose ps",
    "docker:clean": "docker-compose down --remove-orphans"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.15.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
