FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY packages/ui/package*.json ./packages/ui/

# Install dependencies
RUN npm install

# Copy source code
COPY packages/ui ./packages/ui

# Build
RUN npm run build --workspace=packages/ui

# Production image
FROM nginx:alpine

COPY --from=builder /app/packages/ui/dist /usr/share/nginx/html
# .template suffix: the base nginx image envsubst's this into conf.d at
# startup. No ${VAR} substitutions needed anymore (see docs/adr/0002-*.md —
# the old server-side admin bearer injection is gone), kept as a template
# only for consistency in case one is needed again.
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
