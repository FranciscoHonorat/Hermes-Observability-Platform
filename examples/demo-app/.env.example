# Hermes Demo App Configuration

# Server Port
PORT=3030

# Hermes Collector URL
# Default: http://localhost:4000/metrics
COLLECTOR_URL=http://localhost:4000/metrics

# Application Name (will appear in dashboard)
APP_NAME=demo-ecommerce

# Environment Label
ENVIRONMENT=development

# Flush Interval (milliseconds)
# How often to send metrics to collector
# Development: 5000 (5 seconds)
# Production: 30000 (30 seconds)
FLUSH_INTERVAL=5000
